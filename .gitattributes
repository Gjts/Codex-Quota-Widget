# Normalize line endings: text files are stored as LF in the repository.
* text=auto eol=lf

# Windows batch scripts keep CRLF on checkout.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files — never modify.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.icns binary
*.dmg  binary
*.msi  binary
*.exe  binary
